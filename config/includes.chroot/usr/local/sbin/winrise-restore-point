#!/bin/bash
# WinRise: ponto de restauração antes de mudanças de pacotes (no máximo 1 a cada 6 h, guarda os 3 últimos)
grep -qw 'boot=live' /proc/cmdline && exit 0          # nunca no modo live (nem dentro do instalador)
command -v timeshift >/dev/null || exit 0
[ "$(id -u)" = 0 ] || exit 0
CONF=/etc/timeshift/timeshift.json
grep -q '"backup_device_uuid" *: *"[0-9a-fA-F-]\+"' "$CONF" 2>/dev/null || exit 0   # Restauração do Sistema não configurada
STAMP=/var/lib/winrise/last-restore-point; mkdir -p /var/lib/winrise
if [ -f "$STAMP" ] && [ $(( $(date +%s) - $(stat -c %Y "$STAMP") )) -lt 21600 ]; then exit 0; fi
touch "$STAMP"
TAG="Antes de atualizar (WinRise)"
echo "WinRise: criando ponto de restauração antes de atualizar..." >&2
timeout 1800 timeshift --create --scripted --tags O --comments "$TAG" >>/var/log/winrise-restore-point.log 2>&1 || true
# limpa os pontos antigos criados por este script, mantendo os 3 mais novos
timeshift --list --scripted 2>/dev/null | awk -v t="$TAG" 'index($0,t){print $3}' | head -n -3 | while read -r s; do
  [ -n "$s" ] && timeshift --delete --snapshot "$s" --scripted >>/var/log/winrise-restore-point.log 2>&1
done
exit 0
